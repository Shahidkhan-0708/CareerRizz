# ---------------------------------------------------------------------------
# College Outreach Automation System V2 — environment template
#
# 1. Copy this file to `.env` at the project root:  cp .env.example .env
# 2. Fill in real values. Variables marked [REQUIRED] must be set before the
#    server is used in production; the app does NOT fail fast on missing
#    values, so a misconfigured server will start and only break at runtime.
# 3. Never commit `.env` (it is gitignored).
#
# The authoritative list of variables read by the app lives in
# src/config/env.js — keep this file in sync with it.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development        # set to "production" when deployed
BASE_URL=http://localhost:5000

# --- Supabase Database (source of truth) ----------------------------------
SUPABASE_URL=https://your-project.supabase.co            # [REQUIRED]
SUPABASE_SERVICE_KEY=your-supabase-service-role-key      # [REQUIRED] service-role key (server-side only — never expose to the browser)
SUPABASE_ANON_KEY=your-supabase-anon-key                  # [REQUIRED] anon/public key (used by frontend auth + backend JWT verification)

# --- Airtable (dashboard / sync UI) ---------------------------------------
# Optional: sync-only. If left empty, the Airtable sync job will fail loudly
# every 30 min — set these or remove the sync job.
AIRTABLE_TOKEN=pat_your_airtable_token
AIRTABLE_BASE_ID=app_your_base_id
AIRTABLE_TABLE_NAME=Outreach

# --- Email Sending (provider-agnostic SMTP via Nodemailer) -----------------
SMTP_HOST=smtp.your-provider.com      # [REQUIRED] e.g. smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false                     # true for 465, false for 587/STARTTLS
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# [REQUIRED] the from-address/name recipients will see. Replace the placeholder.
MAIL_FROM_EMAIL=your-outreach@your-domain.com
MAIL_FROM_NAME=Your Org Name

# --- Gmail (incoming reply detection) --------------------------------------
# Optional: needed only for the reply-detection job. GMAIL_REDIRECT_URI must
# be the PUBLIC URL of the deployed app (https://app.example.com/auth/google/callback),
# not localhost, or the OAuth callback will fail in production.
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:5000/auth/google/callback
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# --- AI (OpenAI) -----------------------------------------------------------
# [REQUIRED] used for personalization + reply classification.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# --- Outreach configuration & rules ----------------------------------------
DAILY_SEND_LIMIT=10
FOLLOWUP_1_DAYS=7
FOLLOWUP_2_DAYS=14
SEND_DELAY_MS=2000
# How many SMTP sends may be in flight at once (1 = strictly sequential).
SMTP_CONCURRENCY=1

# --- AI processing concurrency ---------------------------------------------
# How many personalization generations may run in parallel.
PERSONALIZATION_CONCURRENCY=5

# --- LinkedIn enrichment (Apify) -------------------------------------------
# Optional: when set, the research engine scrapes LinkedIn profiles and posts
# via Apify actors (no cookies required). Falls back to OpenAlex/Wikipedia/DDG
# when empty. Get a free token at https://console.apify.com/account/integrations
APIFY_TOKEN=
# [REQUIRED for Composio] Platform project key from dashboard.composio.dev.
COMPOSIO_API_KEY=

# --- Security & operations --------------------------------------------------
# [REQUIRED] generate strong random values for all three, e.g.:
#   openssl rand -hex 32
ADMIN_API_KEY=your_secure_admin_api_key
UNSUBSCRIBE_JWT_SECRET=your_jwt_unsubscribe_secret
WEBHOOK_SECRET=your_webhook_secret

# --- Frontend production auth ----------------------------------------------
# Build the V2 console with these set so it can authenticate against the API.
# VITE_SUPABASE_URL must match SUPABASE_URL above.
# VITE_SUPABASE_ANON_KEY is the anon/public key from your Supabase dashboard.
# Example: cd f && VITE_SUPABASE_URL=<url> VITE_SUPABASE_ANON_KEY=<key> npm run build
# (On Windows: set VITE_SUPABASE_URL=<url> && set VITE_SUPABASE_ANON_KEY=<key> && npm run build)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
