{
  "manifest_version": 3,
  "name": "CareerRizz Local Session Bridge & Auto-Filler",
  "version": "1.1.0",
  "description": "Auto-fills ATS applications (Greenhouse, Lever, Ashby, Workday) and stages LinkedIn outreach safely.",
  "permissions": [
    "alarms",
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*"
      ],
      "js": ["content-autofill.js"],
      "run_at": "document_idle"
    }
  ]
}
